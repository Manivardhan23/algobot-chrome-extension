{
  "manifest_version": 3,
  "name": "AlgoBot",
  "version": "1.0",
  "description": "Your AI pair programmer for technical interviews.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://leetcode.com/*", "https://neetcode.io/*"],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://neetcode.io/problems/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://leetcode.com/*", "https://neetcode.io/*"]
    }
  ]
}
